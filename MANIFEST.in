# This MANIFEST.in file tells setuptools which files to include 
# in the sdist package distribution used for building docker image

# ==============================================================================
# Root-level workspace files
# ==============================================================================
include pyproject.toml
include uv.lock

# ==============================================================================
# suricate-sdk
# ==============================================================================
include suricate-sdk/pyproject.toml
recursive-include suricate-sdk *.py
recursive-include suricate-sdk *.j2
recursive-include suricate-sdk py.typed

# ==============================================================================
# suricate-tools
# ==============================================================================
include suricate-tools/pyproject.toml
recursive-include suricate-tools *.py
recursive-include suricate-tools *.j2
recursive-include suricate-tools py.typed

# ==============================================================================
# suricate-workspace
# ==============================================================================
include suricate-workspace/pyproject.toml
recursive-include suricate-workspace *.py
recursive-include suricate-workspace py.typed

# ==============================================================================
# suricate-agent-server
# ==============================================================================
include suricate-agent-server/pyproject.toml
recursive-include suricate-agent-server *.py
recursive-include suricate-agent-server py.typed

# Docker build files
include suricate-agent-server/openhands/agent_server/docker/Dockerfile
include suricate-agent-server/openhands/agent_server/docker/wallpaper.svg

# PyInstaller spec
include suricate-agent-server/openhands/agent_server/agent-server.spec

# VSCode extensions
recursive-include suricate-agent-server/openhands/agent_server/vscode_extensions *
